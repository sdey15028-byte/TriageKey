# Frontend local development override. Omit on Vercel; same-origin /api is the default.
VITE_API_URL=http://localhost:8000/api
# Backend: use pooled Neon URL for API traffic and direct URL for Alembic migrations
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/dbname?ssl=require
DATABASE_DIRECT_URL=postgresql+psycopg://USER:PASSWORD@ep-example.region.aws.neon.tech/dbname?sslmode=require
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:5173
# Proof service
MIDNIGHT_NETWORK=preview
MIDNIGHT_INDEXER_URL=
MIDNIGHT_NODE_URL=
